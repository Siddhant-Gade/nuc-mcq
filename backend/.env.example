# Copy this file to .env and replace placeholders locally. Never commit .env.
# Supabase Storage (Phase 13 study materials) — backend-only, never committed.
# The private "study-materials" bucket must exist in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173
PORT=3000
NODE_ENV=development
